{"name":"Python Dev Hub","icon":"server","settings":"{\"settings\":\"// cSpell:disable\\n{\\n  //MARK: Editor settings\\n  \\\"files.autoSave\\\": \\\"onFocusChange\\\",\\n  \\\"editor.fontFamily\\\": \\\"'Victor Mono','Jetbrains Mono','Fira Code','Cascadia Code','Droid Sans Mono', 'monospace', monospace\\\",\\n  \\\"editor.fontSize\\\": 15,\\n  \\\"editor.fontWeight\\\": \\\"bold\\\",\\n  \\\"editor.fontLigatures\\\": true,\\n  \\\"editor.wordWrap\\\": \\\"on\\\",\\n  \\\"editor.bracketPairColorization.independentColorPoolPerBracketType\\\": true,\\n  \\\"editor.codeLensFontFamily\\\": \\\"'Jetbrains Mono','Victor Mono','Fira Code','Cascadia Code','Droid Sans Mono', 'monospace', monospace\\\",\\n  \\\"editor.guides.bracketPairs\\\": \\\"active\\\",\\n  \\\"editor.linkedEditing\\\": true,\\n  \\\"editor.mouseWheelZoom\\\": true,\\n  \\\"editor.smoothScrolling\\\": true,\\n  \\\"editor.cursorBlinking\\\": \\\"expand\\\",\\n  \\\"editor.cursorSmoothCaretAnimation\\\": \\\"on\\\",\\n  \\\"editor.formatOnPaste\\\": true,\\n  \\\"editor.formatOnSave\\\": true,\\n  \\\"diffEditor.codeLens\\\": true,\\n  \\\"editor.suggest.preview\\\": true,\\n  \\\"editor.minimap.autohide\\\": \\\"mouseover\\\",\\n  \\\"editor.minimap.sectionHeaderFontSize\\\": 8,\\n  \\\"editor.minimap.scale\\\": 2,\\n  \\\"editor.minimap.renderCharacters\\\": false,\\n  \\\"editor.tokenColorCustomizations\\\": {\\n    \\\"textMateRules\\\": [\\n      {\\n        \\\"scope\\\": [\\n          \\\"comment\\\", // Comments in your code\\n          \\\"keyword\\\", // Keywords such as if, else, return, etc.\\n          \\\"storage\\\", // Storage types like var, let, const, function, class, etc.\\n          \\\"constant\\\", // Constants, including constant variables and enumeration members\\n          \\\"entity.name.function\\\", // Function names\\n          \\\"variable.parameter\\\", // Parameters of functions\\n          \\\"variable.language\\\", // Language variables like this, super, etc.\\n        