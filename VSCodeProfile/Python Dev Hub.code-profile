\n  \\\"accessibility.signals.save\\\": {\\n    \\\"sound\\\": \\\"userGesture\\\"\\n  },\\n  //MARK: Search settings\\n  \\\"search.seedWithNearestWord\\\": true,\\n  //MARK: Source Control settings\\n  \\\"scm.defaultViewMode\\\": \\\"tree\\\",\\n  //MARK: Terminal settings\\n  \\\"terminal.integrated.fontFamily\\\": \\\"'MesloLGS NF','consolas'\\\",\\n  \\\"terminal.integrated.hideOnStartup\\\": \\\"whenEmpty\\\",\\n  \\\"terminal.integrated.smoothScrolling\\\": true,\\n  \\\"terminal.integrated.stickyScroll.enabled\\\": true,\\n  // MARK: Problems settings\\n  \\\"problems.showCurrentInStatus\\\": true,\\n  //MARK: Notebook settings\\n  \\\"notebook.lineNumbers\\\": \\\"on\\\",\\n  \\\"notebook.output.wordWrap\\\": true,\\n  \\\"notebook.stickyScroll.enabled\\\": true,\\n  //MARK: Chat settings\\n  \\\"chat.editor.wordWrap\\\": \\\"on\\\",\\n  // MARK: Extensions settings\\n  /* CSS settings */\\n  \\\"css.format.spaceAroundSelectorSeparator\\\": true,\\n  \\\"css.lint.duplicateProperties\\\": \\\"warning\\\",\\n  \\\"css.lint.float\\\": \\\"warning\\\",\\n  \\\"css.lint.idSelector\\\": \\\"warning\\\",\\n  /* Less settings */\\n  \\\"less.format.spaceAroundSelectorSeparator\\\": true,\\n  \\\"less.lint.float\\\": \\\"warning\\\",\\n  \\\"less.lint.duplicateProperties\\\": \\\"warning\\\",\\n  \\\"less.lint.idSelector\\\": \\\"warning\\\",\\n  /* SCSS settings */\\n  \\\"scss.format.spaceAroundSelectorSeparator\\\": true,\\n  \\\"scss.lint.duplicateProperties\\\": \\\"warning\\\",\\n  \\\"scss.lint.float\\\": \\\"warning\\\",\\n  \\\"scss.lint.idSelector\\\": \\\"warning\\\",\\n  /* Git settings */\\n  \\\"git.enableCommitSigning\\\": true,\\n  \\\"git.showPushSuccessNotification\\\": true,\\n  \\\"git.enableSmartCommit\\\": true,\\n  /* Github settings */\\n  \\\"github.gitProtocol\\\": \\\"ssh\\\",\\n  /* JavaScript and Typescript settings */\\n  // \\\"javascript.inlayHints.functionLikeReturnTypes.enabled\\\": true,\\n  // \\\"javascript.inlayHints.parameterNames.enabled\\\": \\\"literals\\\",\\n  // \\\"js/ts.implicitProjectConfig.checkJs\\\": true,\\n  // \\\"js/ts.implicitProjectConfig.target\\\": \\\"ESNext\\\",\\n  // \\\"typescript.implementationsCodeLens.enabled\\\": true,\\n  // \\\"typescript.implementationsCodeLens.showOnInterfaceMethods\\\": true,\\n  // \\\"typescript.suggest.paths\\\": false, // Disable path suggestions if using the path intellisense extension\\n  // \\\"javascript.suggest.paths\\\": false, // Disable path suggestions if using the path intellisense extension\\n  /* Live Share settings */\\n  \\\"liveshare.guestApprovalRequired\\\": true,\\n  /* CodeSnap settings */\\n  \\\"codesnap.showLineNumbers\\\": false,\\n  /*Git Lens settings*/\\n  \\\"gitlens.blame.fontFamily\\\": \\\"'Jetbrains Mono','Victor Mono','Fira Code','Cascadia Code','Droid Sans Mono', 'monospace', monospace\\\",\\n  \\\"gitlens.blame.fontSize\\\": 15,\\n  \\\"gitlens.blame.fontWeight\\\": \\\"600\\\",\\n  \\\"gitlens.graph.dimMergeCommits\\\": true,\\n  \\\"gitlens.launchpad.indicator.useColors\\\": true,\\n  /* VSCode-Pets settings */\\n  \\\"vscode-pets.theme\\\": \\\"autumn\\\",\\n  /* REST Client settings */\\n  \\\"rest-client.fontFamily\\\": \\\"'Jetbrains Mono','Victor Mono','Fira Code','Cascadia Code','Droid Sans Mono', 'monospace', monospace\\\",\\n  \\\"rest-client.fontWeight\\\": \\\"600\\\",\\n  /* Github Codespaces settings */\\n  // \\\"github.codespaces.createCodespaceInNewWindow\\\": true,\\n  // \\\"github.codespaces.showPerformanceExplorer\\\": true,\\n  /* Remote Repositories settings */\\n  \\\"remoteHub.gitProtocol\\\": \\\"ssh\\\",\\n  /*Material Icon Theme settings */\\n  \\\"material-icon-theme.activeIconPack\\\": \\\"react_redux\\\",\\n  \\\"material-icon-theme.folders.color\\\": \\\"#6A5ACD\\\", //Turquoise\\n  \\\"material-icon-theme.files.color\\\": \\\"#40E0D0\\\", // Stale Blue\\n  /*Pylance settings*/\\n  \\\"python.analysis.autoImportCompletions\\\": true,\\n  \\\"python.analysis.inlayHints.