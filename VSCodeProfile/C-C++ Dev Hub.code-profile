{"name":"C/C++ Dev Hub","icon":"code","settings":"{\"settings\":\"// cSpell:disable\\n\\n{\\n  //MARK: Editor settings\\n\\n  \\\"files.autoSave\\\": \\\"onFocusChange\\\",\\n  \\\"editor.fontFamily\\\": \\\"'Victor Mono','Jetbrains Mono','Fira Code','Cascadia Code','Droid Sans Mono', 'monospace', monospace\\\",\\n  \\\"editor.fontSize\\\": 15,\\n  \\\"editor.fontWeight\\\": \\\"bold\\\",\\n  \\\"editor.fontLigatures\\\": true,\\n  \\\"editor.wordWrap\\\": \\\"on\\\",\\n  \\\"editor.bracketPairColorization.independentColorPoolPerBracketType\\\": true,\\n  \\\"editor.codeLensFontFamily\\\": \\\"'Jetbrains Mono','Victor Mono','Fira Code','Cascadia Code','Droid Sans Mono', 'monospace', monospace\\\",\\n  \\\"editor.defaultFormatter\\\": \\\"ms-vscode.cpptools\\\",\\n  \\\"editor.guides.bracketPairs\\\": \\\"active\\\",\\n  \\\"editor.linkedEditing\\\": true,\\n  \\\"editor.mouseWheelZoom\\\": true,\\n  \\\"editor.smoothScrolling\\\": true,\\n  \\\"editor.cursorBlinking\\\": \\\"expand\\\",\\n  \\\"editor.cursorSmoothCaretAnimation\\\": \\\"on\\\",\\n  \\\"editor.formatOnPaste\\\": true,\\n  \\\"editor.formatOnSave\\\": true,\\n  \\\"diffEditor.codeLens\\\": true,\\n  \\\"editor.suggest.preview\\\": true,\\n  \\\"editor.minimap.autohide\\\": \\\"mouseover\\\",\\n  \\\"editor.minimap.sectionHeaderFontSize\\\": 8,\\n  \\\"editor.minimap.scale\\\": 2,\\n  \\\"editor.minimap.renderCharacters\\\": false,\\n  \\\"editor.tokenColorCustomizations\\\": {\\n    \\\"textMateRules\\\": [\\n      {\\n        \\\"scope\\\": [\\n          \\\"comment\\\", // Comments in your code\\n          \\\"keyword\\\", // Keywords such as if, else, return, etc.\\n          \\\"storage\\\", // Storage types like var, let, const, function, class, etc.\\n          \\\"constant\\\", // Constants, including constant variables and enumeration members\\n          \\\"entity.name.function\\\", // Function names\\n          \\\"variable.parameter\\\", // Parameters of functions\\n          \\\"variable.language\\\", // Language variables like this, super, etc.\\n          \\\"markup.italic\\\", // Text marked as italic in markup languages\\n          \\\"meta.tag\\\", // HTML and JSX,TSX tags\\n          \\\"entity.name.tag\\\" // HTML and JSX,TSX tags (both are needed in some themes)\\n        ],\\n        \\\"settings\\\": {\\n          \\\"fontStyle\\\": \\\"italic\\\"\\n        }\\n      }\\n    ]\\n  },\\n\\n  //MARK: Workbench settings\\n\\n  \\\"workbench.list.smoothScrolling\\\": true,\\n  \\\"workbench.editor.highlightModifiedTabs\\\": true,\\n  \\\"workbench.colorTheme\\\": \\\"Shades of Purple (Super Dark)\\\",\\n  \\\"workbench.preferredDarkColorTheme\\\": \\\"Shades of Purple (Super Dark)\\\",\\n  \\\"workbench.preferredLightColorTheme\\\": \\\"Quiet Light\\\",\\n  \\\"workbench.editor.pinnedTabSizing\\\": \\\"compact\\\",\\n  \\\"workbench.iconTheme\\\": \\\"material-icon-theme\\\",\\n  \\\"workbench.colorCustomizations\\\": {\\n    \\\"editorBracketHighlight.foreground1\\\": \\\"#fbff00\\\",\\n    \\\"editorBracketHighlight.foreground2\\\": \\\"#00f7ff\\\",\\n    \\\"editorBracketHighlight.foreground3\\\": \\\"#ff8000\\\",\\n    \\\"editorBracketHighlight.foreground4\\\": \\\"#15ff00\\\",\\n    \\\"editorBracketHighlight.foreground5\\\": \\\"#e100ff\\\",\\n    \\\"editorBracketHighlight.foreground6\\\": \\\"#ff5fcf\\\",\\n\\n    /*Bookmarks settings*/\\n    \\\"bookmarks.lineBackground\\\": \\\"#0077ff2a\\\",\\n    \\\"bookmarks.lineBorder\\\": \\\"#FF0000\\\",\\n    \\\"bookmarks.overviewRuler\\\": \\\"#157EFB88\\\"\\n  },\\n\\n  // MARK: Zen Mode settings\\n\\n  \\\"zenMode.centerLayout\\\": false,\\n  \\\"zenMode.hideLineNumbers\\\": false,\\n  \\\"zenMode.hideStatusBar\\\": false,\\n  \\\"zenMode.hideActivityBar\\\": false,\\n\\n  //MARK: Window settings\\n\\n  \\\"window.autoDetectColorScheme\\\": true,\\n  // \\\"window.confirmBeforeClose\\\": \\\"keyboardOnly\\\",\\n  // \\\"window.titleBarStyle\\\": \\\"custom\\\",\\n  // \\\"window.customTitleBarVisibility\\\": \\\"auto\\\",\\n  // \\\"window.dialogStyle\\\": \\\"custom\\\",\\n\\n  //MARK: Accessibility settings\\n\\n  \\\"accessibility.signals.save\\\": {\\n    \\\"sound\\\": \\\"userGesture\\\"\\n  },\\n\\n  //MARK: Search settings\\n\\n  \\\"search.seedWithNearestWord\\\": true,\\n\\n  //MARK: Source Control settings\\n\\n  \\\"scm.defaultViewMode\\\": \\\"tree\\\",\\n\\n  //MARK: Terminal settings\\n\\n  \\\"terminal.integrated.fontFamily\\\": \\\"'MesloLGS NF','consolas'\\\",\\n  \\\"terminal.integrated.hideOnStartup\\\": \\\"whenEmpty\\\",\\n  \\\"terminal.integrated.smoothScrolling\\\": true,\\n  \\\"terminal.integrated.stickyScroll.enabled\\\": true,\\n\\n  // MARK: Problems settings\\n\\n  \\\"problems.showCurrentInStatus\\\": true,\\n\\n  //MARK: Notebook settings\\n\\n  \\\"notebook.lineNumbers\\\": \\\"on\\\",\\n  \\\"notebook.output.wordWrap\\\": true,\\n  \\\"notebook.stickyScroll.enabled\\\": true,\\n\\n  //MARK: Chat settings\\n\\n  \\\"chat.editor.wordWrap\\\": \\\"on\\\",\\n\\n  // MARK: Extensions settings\\n\\n  /* CSS settings */\\n  \\\"css.format.spaceAroundSelectorSeparator\\\": true,\\n  \\\"css.lint.duplicateProperties\\\": \\\"warning\\\",\\n  \\\"css.lint.float\\\": \\\"warning\\\",\\n  \\\"css.lint.idSelector\\\": \\\"warning\\\",\\n\\n  /* Less settings */\\n  \\\"less.format.spaceAroundSelectorSeparator\\\": true,\\n  \\\"less.lint.float\\\": \\\"warning\\\",\\n  \\\"less.lint.duplicateProperties\\\": \\\"warning\\\",\\n  \\\"less.lint.idSelector\\\": \\\"warning\\\",\\n\\n  /* SCSS settings */\\n  \\\"scss.format.spaceAroundSelectorSeparator\\\": true,\\n  \\\"scss.lint.duplicateProperties\\\": \\\"warning\\\",\\n  \\\"scss.lint.float\\\": \\\"warning\\\",\\n  \\\"scss.lint.idSelector\\\": \\\"warning\\\",\\n\\n  /* Git settings */\\n  \\\"git.enableCommitSigning\\\": true,\\n  \\\"git.showPushSuccessNotification\\\": true,\\n  \\\"git.enableSmartCommit\\\": true,\\n\\n  /* Github settings */\\n  \\\"github.gitProtocol\\